{
  "name": "dsh-llm-wiki",
  "version": "0.4.3",
  "description": "从 Karpathy 在 GitHub 发布的 LLM Wiki 说明出发实现。欢迎试用，也欢迎让自己的 agent 参与。",
  "type": "module",
  "private": true,
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./parsers": "./parsers.js",
    "./present": "./present.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "index.js",
    "parsers.js",
    "present.js",
    "split.js",
    "pages.js",
    "store.js",
    "patch.js",
    "llm.js",
    "llm-mode.js",
    "embed.js",
    "retrieve.js",
    "workflow.js",
    "graph.js",
    "slug.js",
    "SKILL.md",
    "install.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "pinyin-pro": "^3.27.0"
  }
}
